# Bruno CLI → OpenBao (AppRole bruno-api-client). No values here: the broker
# (devenv / ops-cli secret run, see .secrets.refs) puts them into the environment of bru.
BRUNO_HASHICORP_VAULT_SERVER_URL=https://secrets.int.integral-systems.ch
BRUNO_HASHICORP_VAULT_SERVER_NAMESPACE=sunnyside-up
BRUNO_HASHICORP_VAULT_SERVER_AUTH_METHOD=app_role
BRUNO_HASHICORP_VAULT_SERVER_APPROLE_ROLE=bruno-api-client
BRUNO_HASHICORP_VAULT_SERVER_APPROLE_MOUNT_PATH=approle
BRUNO_HASHICORP_VAULT_SERVER_APPROLE_ROLE_ID={{process.env.BRUNO_VAULT_ROLE_ID}}
BRUNO_HASHICORP_VAULT_SERVER_APPROLE_SECRET_ID={{process.env.BRUNO_VAULT_SECRET_ID}}
