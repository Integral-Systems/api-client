        "name": "",
        "productId": "",
        "familySharable": false,
        "subscriptionPeriod": "",
        "reviewNote": "",
        "groupLevel": 0
      },
      "relationships": {
        "group": {
          "data": {
            "type": "",
            "id": ""
          }
        }
      }
    }
  }
}
