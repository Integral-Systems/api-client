meta {
  name: Snapschot-restore
  type: http
  seq: 6
}

post {
  url: {{host}}/_snapshot/backup/pre/_restore
  body: json
  auth: basic
}

headers {
  Content-Type: application/json
}

auth:basic {
  username: {{admin_user}}
  password: {{admin_pass}}
}

body:json {
  {
    "include_global_state": false,
    "indices": [
      ".kibana*",
      "-.opensearch-security*",
      "-security-auditlog-2025.11.10"
  ]
  }
}
